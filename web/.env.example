# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables (the Deploy button asks for them).

WHATSAPP_ACCESS_TOKEN=        # System User token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=     # WhatsApp > API Setup in your Meta app
WHATSAPP_WABA_ID=             # WhatsApp Business Account ID (for list_templates)
META_APP_SECRET=              # App settings > Basic > App secret (verifies webhook signatures)
WEBHOOK_VERIFY_TOKEN=         # any random string; type the same one in Meta's webhook settings
MCP_SECRET=                   # random, 24+ characters: openssl rand -hex 24
# Added automatically when you connect Upstash Redis from the Vercel Storage tab:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# GRAPH_API_VERSION=v26.0
